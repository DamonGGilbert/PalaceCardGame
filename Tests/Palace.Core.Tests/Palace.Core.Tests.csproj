<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the Palace rules engine outside Unity.
    From this folder:  dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Palace\Scripts\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Palace\Scripts\Net\NetProtocol.cs" Link="Net\NetProtocol.cs" />
  </ItemGroup>

</Project>
